# Zoho OAuth (create a Server-based app at https://api-console.zoho.com)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Must match the redirect URI registered in the Zoho API console
ZOHO_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Use accounts.zoho.in / .eu / .com.au etc. for other data centres
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# Zoho MCP server endpoint (exposes the get_projects tool)
ZOHO_MCP_URL=
SESSION_SECRET=change-me-to-a-long-random-string
